<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id='hr_contract_arl_view_form' model='ir.ui.view'>
        <field name='name'>hr_contract_arl.hr.contract.form</field>
        <field name='model'>hr.contract</field>
        <field name='inherit_id' ref='hr_contract.hr_contract_view_form' />
        <field name='arch' type='xml'>
            <xpath expr="//field[@name='wage']/ancestor::group[2]" position="replace">
                <group name="salary_info">
                    <group name="salary">
                        <label for="wage" />
                        <div class="o_row mw-50" name="wage">
                            <field name="wage" class="oe_inline o_hr_narrow_field" nolabel="1" />
                            <div class="mb-3" name="wage_period_label">/ mes</div>
                        </div>
                    </group>
                    <group>
                    <field name='arl_fee'/>
                    </group>
                    <group name="yearly_benefits" />
                </group>
            </xpath>
            <xpath expr="//group[@name='contract_details_0']" position="inside">
                <group string='Seguridad Social'>
                    <field name="eps_id"/>
                    <field name="pension_fund_id"/>
                    <field name="arl_id"/>
                    <field name="compensation_check"/>
                    <field name="compensation_fund_id" invisible="compensation_check == False"/>
                </group>
                <group string='SENA'>
                    <field name='sena_apprentice'/>
                    <field name='apprentice_type'/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>