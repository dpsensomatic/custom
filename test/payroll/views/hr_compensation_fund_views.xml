<odoo>

    <!-- Form -->
    <record id="view_hr_compensation_fund_form" model="ir.ui.view">
        <field name="name">hr.compensation.fund.form</field>
        <field name="model">hr.compensation.fund</field>
        <field name="arch" type="xml">
            <form>
                <group string="Configurar caja de compensacion">
                    <field name="name" />
                    <field name="nit" />
                    <field name="code" />
                    <field name="phone" />
                    <field name="address" />
                    <field name="compensation_account" />
                    <field name="active" />
                </group>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_hr_compensation_fund_list" model="ir.ui.view">
        <field name="name">hr.compensation.fund.list</field>
        <field name="model">hr.compensation.fund</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="nit" />
                <field name="code" />
                <field name="phone" />
                <field name="address" />
                <field name="compensation_account" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_compensation_fund" model="ir.actions.act_window">
        <field name="name">caja de compensacion</field>
        <field name="res_model">hr.compensation.fund</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hr_compensation_fund" name="Configurar caja de compensacion"
        parent="payroll.contributions" action="action_hr_compensation_fund" />
</odoo>