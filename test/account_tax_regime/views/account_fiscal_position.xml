<odoo>
    <record id='x_account_tax_views_form' model='ir.ui.view'>
        <field name='name'>account_fiscal_position_views.account.fiscal.position.form</field>
        <field name='model'>account.fiscal.position</field>
        <field name='inherit_id' ref='account.view_account_position_form' />
        <field name='arch' type='xml'>
            <xpath expr='//field[@name="country_id"]' position='after'>
                <field name='invoice_level_tax_ids'/>
            </xpath>
        </field>
    </record>
</odoo>