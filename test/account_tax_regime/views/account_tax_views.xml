<odoo>
    <record id='x_account_tax_views' model='ir.ui.view'>
        <field name='name'>x_account_tax_views.account.tax.form</field>
        <field name='model'>account.tax</field>
        <field name='inherit_id' ref='account.view_tax_form'/>
        <field name='arch' type='xml'>
            <xpath expr='//field[@name="is_base_affected"]' position='after'>
                <field name="apply_on_invoice_total"/> 
            </xpath>
        </field>
    </record>
</odoo>