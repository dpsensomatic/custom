<odoo>

    <!-- Form -->
    <record id="view_hr_eps_entity_form" model="ir.ui.view">
        <field name="name">hr.eps.entity.form</field>
        <field name="model">hr.eps.entity</field>
        <field name="arch" type="xml">
            <form>
                <group string="Configurar EPS">
                    <field name="name" />
                    <field name="code" />
                    <field name="phone" />
                    <field name="address" />
                    <field name="eps_account" />
                    <field name="active" />
                </group>
            </form>
        </field>
    </record>

    <!-- List -->
    <record id="view_hr_eps_entity_list" model="ir.ui.view">
        <field name="name">hr.eps.entity.list</field>
        <field name="model">hr.eps.entity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="phone" />
                <field name="address" />
                <field name="eps_account" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_eps_entity" model="ir.actions.act_window">
        <field name="name">Eps</field>
        <field name="res_model">hr.eps.entity</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hr_eps_entity" name="Configurar Eps"
        parent="payroll.contributions" action="action_hr_eps_entity" />
</odoo>